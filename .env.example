# ========================================================
# EnglishPractice Environment Configuration (.env.example)
# ========================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-very-secure-random-secret-key-in-production
PORT=5000

# MariaDB 10.11+ Connection Parameters
DB_HOST=db
DB_PORT=3306
DB_USER=practice_user
DB_PASSWORD=practice_password123
DB_NAME=english_practice_db

# Set USE_SQLITE=true if you want to quickly test locally without MariaDB
USE_SQLITE=false

# SMTP Mail Server Configuration (Flask-Mail)
# If MAIL_USERNAME is left blank or MAIL_SUPPRESS_SEND=true, reset links will log to terminal/console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@englishpractice.local
MAIL_SUPPRESS_SEND=true
